# OmniPulse configuration. Copy to .env (docker compose) or backend/.env (bare metal).
# Every value maps to OMNIPULSE_* env vars. Defaults are chosen so the system
# streams live news with ZERO API keys.

# ---- engine profile ----
# v2 (default): the merged engine — /api/*, stdio MCP, frontend/ app with BOTH
#     terminal skins (tape ⇄ tiling, switchable in the UI like a theme)
# v1 (legacy): the original architecture — Redis-stream pipeline, Timescale
#     store, sharded engine, standalone tiling terminal (frontend_v1/),
#     /v1/* API, HTTP MCP at /mcp. Kept for reference / comparison.
#OMNIPULSE_PROFILE=v2

# ---- core ----
OMNIPULSE_ENV=production
# Optional bearer/X-API-Key guard on /api and stream endpoints. Leave unset for open local use.
#OMNIPULSE_API_KEY=
OMNIPULSE_PUBLIC_URL=http://localhost:8000
OMNIPULSE_SOURCES_FILE=config/default_sources.json

# ---- infrastructure (unset => built-in in-process fallbacks, no external services needed) ----
OMNIPULSE_DATABASE_URL=postgresql://omnipulse:omnipulse@localhost:5432/omnipulse
OMNIPULSE_REDIS_URL=redis://localhost:6379/0

# ---- optional LLM enrichment (heuristic NLP fallback used when absent) ----
#OMNIPULSE_LLM_PROVIDER=auto            # auto|none|openai|anthropic|ollama|openai_compatible
#OMNIPULSE_OPENAI_API_KEY=
#OMNIPULSE_OPENAI_MODEL=gpt-4o-mini
#OMNIPULSE_ANTHROPIC_API_KEY=
#OMNIPULSE_ANTHROPIC_MODEL=claude-haiku-4.5
#OMNIPULSE_OLLAMA_URL=http://localhost:11434
#OMNIPULSE_OLLAMA_MODEL=llama3.1:8b
# openai_compatible: point at any /v1/chat/completions endpoint. Set these ONLY
# in your local .env (gitignored) — never commit real endpoints/keys/model ids.
#OMNIPULSE_LLM_PROVIDER=openai_compatible
#OMNIPULSE_LLM_BASE_URL=
#OMNIPULSE_LLM_API_KEY=
#OMNIPULSE_LLM_MODEL=

# ---- v1 profile (OMNI_* namespace; only used when OMNIPULSE_PROFILE=v1) ----
#OMNI_MODE=lite                         # lite (zero infra) | full (Redis + Timescale)
#OMNI_SOURCES_FILE=config/v1_sources.json
#OMNI_EMBEDDER=hash                     # auto|hash|fastembed|openai|ollama
#OMNI_REDIS_URL=redis://localhost:6379/0
#OMNI_DATABASE_URL=postgresql://omni:omni@localhost:5432/omnipulse
#OMNI_LLM_PROVIDER=none                 # none|openai|anthropic|ollama|openai_compatible
#OMNI_LLM_BASE_URL=
#OMNI_LLM_API_KEY=
#OMNI_LLM_MODEL=

# ---- optional keyed source connectors (sources requiring them stay paused until set) ----
#OMNIPULSE_NEWSAPI_KEY=
#OMNIPULSE_WHALE_ALERT_KEY=
#OMNIPULSE_TELEGRAM_API_ID=
#OMNIPULSE_TELEGRAM_API_HASH=

# ---- http politeness & speed ----
OMNIPULSE_USER_AGENT=OmniPulse/1.0 (+news aggregation terminal; contact: ops@omnipulse.local)
OMNIPULSE_PER_HOST_RATE=2.0
OMNIPULSE_PER_HOST_BURST=6
OMNIPULSE_HTTP2=true
OMNIPULSE_KEEPALIVE_EXPIRY_SEC=300

# ---- latency tuning ----
OMNIPULSE_POLL_TICK_SEC=0.1
OMNIPULSE_STATS_INTERVAL_SEC=1.0
OMNIPULSE_CLUSTER_CANDIDATE_CAP=600

# ---- websub push (instant delivery; only with a publicly reachable PUBLIC_URL) ----
#OMNIPULSE_WEBSUB_ENABLED=false
